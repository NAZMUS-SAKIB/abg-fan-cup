DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
# Neon non-pooler URL (same host without -pooler) — required for prisma migrate
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
JWT_SECRET="change-me-to-a-long-random-string"
FRONTEND_URL="http://localhost:4200"
CORS_ORIGIN="*"
PORT=3000

# --- Real magic-link email (pick ONE) ---
# Option A — Gmail SMTP (recommended for ABG Gmail). Use an App Password, not the login password.
# Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="abgsportscity@gmail.com"
SMTP_PASS="your-16-char-app-password"
MAIL_FROM="ABG Fan Cup <abgsportscity@gmail.com>"
MAIL_REPLY_TO="abgsportscity@gmail.com"

# Option B — Resend (needs verified domain for inbox delivery to the public)
# RESEND_API_KEY="re_xxx"
# MAIL_FROM="ABG Fan Cup <votes@your-verified-domain.com>"

TURNSTILE_SECRET_KEY=""

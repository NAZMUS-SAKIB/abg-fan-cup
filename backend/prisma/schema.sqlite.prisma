generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon: pooled URL for app; direct (non-pooler) for migrate advisory locks
  directUrl = env("DIRECT_URL")
}

model University {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  sortOrder Int         @default(0) @map("sort_order")
  createdAt DateTime    @default(now()) @map("created_at")
  votes     Vote[]
  count     VoteCount?

  @@map("universities")
}

model Vote {
  id              Int        @id @default(autoincrement())
  universityId    Int        @map("university_id")
  email           String?    @unique
  deviceKey       String?    @unique @map("device_key")
  fingerprintHash String?    @unique @map("fingerprint_hash")
  ip              String?
  userAgent       String?    @map("user_agent")
  createdAt       DateTime   @default(now()) @map("created_at")
  university      University @relation(fields: [universityId], references: [id])

  @@index([universityId])
  @@index([createdAt])
  @@index([ip])
  @@map("votes")
}

model MagicLinkToken {
  id        Int       @id @default(autoincrement())
  email     String
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@index([createdAt])
  @@map("magic_link_tokens")
}

model VoteCount {
  universityId Int        @id @map("university_id")
  count        Int        @default(0)
  updatedAt    DateTime   @updatedAt @map("updated_at")
  university   University @relation(fields: [universityId], references: [id])

  @@map("vote_counts")
}

model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admins")
}

model Setting {
  id                Int      @id @default(1)
  votingEndsAt      DateTime @map("voting_ends_at")
  magicLinkRequired Boolean  @default(true) @map("magic_link_required")

  @@map("settings")
}
